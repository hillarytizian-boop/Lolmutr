# --- Trading mode ----------------------------------------------------------
# demo/paper = simulated fills at last price (default, safest)
# testnet    = signed orders on https://testnet.binance.vision
# live       = signed orders on https://api.binance.com  (requires extra confirm)
TRADING_MODE=demo

PAPER_STARTING_CASH=10
STAKE_USD=10
GOAL_USD=50
MIN_NOTIONAL=5

# --- Autotrader (python -m app trade) --------------------------------------
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
INTERVAL=1h
LOOP_SECONDS=900
MIN_CONFIDENCE=0.58
MAX_POSITIONS=1
MAX_DAILY_LOSS_PCT=15
COOLDOWN_MINUTES=20
AUTO_EXECUTE=true
PROFIT_MODE=true
MANAGE_SECONDS=60
TRAIL_ATR=1.8
RISK_PER_TRADE=0.02
MAX_POSITION_PERCENT=0.90
MAX_EXPOSURE=1.0
UNPROTECTED_POLICY=flatten

# --- Binance (needed for testnet / live) -----------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Aliases also accepted: EXCHANGE_API_KEY / EXCHANGE_API_SECRET
# Extra safety latch for live mode. Must be I_UNDERSTAND or true.
BINANCE_LIVE_CONFIRM=
LIVE_TRADING_CONFIRM=

# --- LLM (Termux-friendly OpenAI-compatible) -------------------------------
# Official TradingAgents brain (required for any BUY/SELL)
LLM_PROVIDER=nvidia
LLM_MODEL=z-ai/glm-5.2
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Aliases: NVIDIA_NIM_API_KEY, NVAPI_KEY

TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_DEEP_THINK_MODEL=z-ai/glm-5.2
TRADINGAGENTS_QUICK_THINK_MODEL=z-ai/glm-5.2
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_LLM_BACKEND_URL=https://integrate.api.nvidia.com/v1

# Optional other providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

HOST=0.0.0.0
PORT=8000
