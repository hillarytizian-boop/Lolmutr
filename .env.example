# Runtime: paper (default), testnet, or live
APP_MODE=paper
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DATA_DIR=./data
APP_LOG_LEVEL=INFO

# Comma-separated Binance Spot symbols
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_QUOTE_ASSET=USDT
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Required for live mode; sent as X-Control-Token on mutating API calls.
CONTROL_API_TOKEN=

# Hard safety gate. Live orders are impossible unless both values are set.
BINANCE_LIVE_TRADING=false
AUTO_TRADING_ENABLED=false
AUTO_EXECUTE=false
AGENT_INTERVAL_MINUTES=60

# Portfolio controls
PAPER_STARTING_BALANCE=10000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=15.0
MIN_CONFIDENCE=62
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# TradingAgents integration. With no provider key the app uses transparent
# deterministic demo intelligence, so the dashboard still works locally.
TRADINGAGENTS_ENABLED=true
ALLOW_DEMO_FALLBACK=true
LLM_PROVIDER=openai
DEEP_THINK_LLM=gpt-5.5
QUICK_THINK_LLM=gpt-5.4-mini
LLM_BACKEND_URL=
OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional data providers consumed by TradingAgents
# ALPHA_VANTAGE_API_KEY=
# FRED_API_KEY=
