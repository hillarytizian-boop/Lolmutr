# --- Trading mode ----------------------------------------------------------
# paper   = simulated fills at Binance last price (default, safest)
# testnet = signed orders on https://testnet.binance.vision
# live    = signed orders on https://api.binance.com  (requires extra confirm)
TRADING_MODE=paper

# Starting paper-trading cash in USDT
PAPER_STARTING_CASH=10000

# --- Binance (only needed for testnet / live) ------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Extra safety latch for live mode. Must be the literal string I_UNDERSTAND
# or live orders are refused even if TRADING_MODE=live.
BINANCE_LIVE_CONFIRM=

# --- Optional LLM / TradingAgents ------------------------------------------
# If tradingagents is installed AND one of these keys is set, analysis can
# run the official Tauric Research graph (crypto asset mode) in addition
# to the Binance-native desk.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-4.1
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-4.1-mini
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
