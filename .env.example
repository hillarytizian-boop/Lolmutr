# --- Trading mode ----------------------------------------------------------
# paper   = simulated fills at Binance last price (default, safest)
# testnet = signed orders on https://testnet.binance.vision
# live    = signed orders on https://api.binance.com  (requires extra confirm)
TRADING_MODE=paper

PAPER_STARTING_CASH=10
STAKE_USD=10
GOAL_USD=50
MIN_NOTIONAL=5

# --- Autotrader (python -m app trade) --------------------------------------
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
INTERVAL=1h
LOOP_SECONDS=900
MIN_CONFIDENCE=0.58
MAX_POSITIONS=3
MAX_DAILY_LOSS_PCT=5
COOLDOWN_MINUTES=45
AUTO_EXECUTE=true
PROFIT_MODE=true
MANAGE_SECONDS=60
TRAIL_ATR=1.4

# --- Binance (needed for testnet / live) -----------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Extra safety latch for live mode. Must be the literal string I_UNDERSTAND
# or live orders are refused even if TRADING_MODE=live.
BINANCE_LIVE_CONFIRM=

# --- LLM (Termux-friendly OpenAI-compatible) -------------------------------
# Official TradingAgents brain (required for any BUY/SELL)
TRADINGAGENTS_LLM_PROVIDER=
TRADINGAGENTS_DEEP_THINK_MODEL=
TRADINGAGENTS_QUICK_THINK_MODEL=
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_LLM_BACKEND_URL=

# groq | openai | openrouter | deepseek | gemini | xai
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-4.1
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-4.1-mini

HOST=0.0.0.0
PORT=8000
